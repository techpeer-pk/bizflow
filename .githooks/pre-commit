#!/bin/sh
# Blocks a commit that would put keys or secrets into git.
# Turned on per clone with:  git config core.hooksPath .githooks
# Matching text is never printed, so the hook itself can't leak a key into a terminal or CI log.

# Each pattern needs a real value after it, so this line doesn't match itself.
PATTERN='AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----|"private_key"[[:space:]]*:|"client_secret"[[:space:]]*:[[:space:]]*"[^"]+|sk_live_[0-9A-Za-z]+|ghp_[0-9A-Za-z]{20,}|xox[abprs]-[0-9A-Za-z-]+'
BLOCKED_FILES='(^|/)firebase-config\.js$|(^|/)\.env($|\.)|\.(pem|key|p12|pfx|keystore)$|service-?account.*\.json$|firebase-adminsdk.*\.json$|(^|/)credentials.*\.json$|(^|/)\.runtimeconfig\.json$'

status=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

bad_names=$(printf '%s\n' "$staged" | grep -E "$BLOCKED_FILES" | grep -v -E '(^|/)\.env\.example$|\.example\.js$')
if [ -n "$bad_names" ]; then
  echo "pre-commit: these files hold keys or secrets and must not be committed:" >&2
  printf '%s\n' "$bad_names" | sed 's/^/  /' >&2
  status=1
fi

# Scan the staged content (not the working copy) of every added or changed text file.
bad_content=$(printf '%s\n' "$staged" | while IFS= read -r f; do
  git show ":$f" 2>/dev/null | grep -I -q -E "$PATTERN" && printf '%s\n' "$f"
done)
if [ -n "$bad_content" ]; then
  echo "pre-commit: these staged files contain an API key, token or private key:" >&2
  printf '%s\n' "$bad_content" | sed 's/^/  /' >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "Commit blocked. Move the secret to a git-ignored file (see assets/js/firebase-config.example.js)." >&2
fi
exit $status
